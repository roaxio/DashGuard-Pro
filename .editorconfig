# EditorConfig helps maintain consistent coding styles across IDEs
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Kotlin & Java
[*.{kt,kts,java}]
indent_size = 4
max_line_length = 120

# Gradle & Build scripts
[*.gradle.kts]
indent_size = 2

# XML Layouts & Manifests
[*.xml]
indent_size = 4

# JSON, YAML, TOML
[*.{json,yml,yaml,toml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off
